# --- Google Gemini API (powers the Text Humanizer) ---
# Get a free key at https://aistudio.google.com/apikey — sign in with a
# Google account, no credit card or phone verification required. The free
# tier has generous daily request limits on the Flash model this app uses.
GEMINI_API_KEY=

# --- Supabase (usage tracking + waitlist) ---
# Create a free project at https://supabase.com, then find these under
# Project Settings > API.
# SUPABASE_URL is the "Project URL". SUPABASE_SERVICE_ROLE_KEY is the
# "service_role" secret key (NOT the anon/public key) — it is only ever
# used server-side and must never be exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site config ---
# The public URL this site is deployed at, used for metadata, Open Graph
# tags, and the sitemap. Set this to your real domain once you have one.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google AdSense (optional, only after you're approved) ---
# Leave blank until you have a real AdSense publisher ID — the ad script
# and ad slots stay completely inactive (nothing renders) until this is set.
# Format: ca-pub-XXXXXXXXXXXXXXXX (find it in your AdSense account).
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
